---
import { SITE_OWNER } from "../config";

const today = new Date();
---

<footer>
  &copy; {today.getFullYear()}
  {SITE_OWNER} - powered by Astro
</footer>
<style>
  footer {
    padding: 25px;
    text-align: center;
  }
</style>

<!-- Google tag (gtag.js) -->
<script
  type="text/partytown"
  async
  src="https://www.googletagmanager.com/gtag/js?id=UA-1311130-7"
></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "UA-1311130-7");
</script>
