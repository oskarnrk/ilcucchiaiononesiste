---
export interface Props {
  posts: Record<string, any>[];
  filter: (post: Record<string, any>) => boolean;
  sort: (a: Record<string, any>, b: Record<string, any>) => number;
}

const { posts, filter, sort } = Astro.props;

const postsList = posts.filter(filter).sort(sort);
---

<section>
  <div class="content">
    {
      postsList.map((post) => (
        <div class="block">
          <span class="tag">
            <time datetime={post.frontmatter.date}>
              {new Date(post.frontmatter.date).toLocaleDateString("it-it", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </span>
          <a href={post.url}>{post.frontmatter.title}</a>
        </div>
      ))
    }
  </div>
</section>
