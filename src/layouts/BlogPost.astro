---
import Main from "../components/Main.astro";

export interface Props {
  content: {
    title: string;
    date?: string;
    updatedDate?: string;
    image?: string;
    categories?: string[];
    tags?: string[];
  };
}

const {
  content: { title, date, updatedDate, image },
} = Astro.props;
---

<Main title={title}>
  <article>
    <div class="content">
      {image && <img width={720} height={360} src={image} alt="" />}
      <h2 class="title is-2">{title}</h2>
      {date && <time>{date}</time>}
      {
        updatedDate && (
          <div>
            Last updated on <time>{updatedDate}</time>
          </div>
        )
      }
      <slot />
    </div>
  </article>
</Main>
