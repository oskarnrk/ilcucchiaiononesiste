---
import Main from "../components/Main.astro";
import PostsList from "../components/PostsList.astro";

// Use Astro.glob() to fetch all posts, and then sort them by date.
const posts = Object.values(
  import.meta.glob("./2*/**/index.{md,mdx}", { eager: true }),
) as Record<string, any>[];

const filter: (post: Record<string, any>) => boolean = (post) =>
  !post.frontmatter.draft &&
  parseInt(post.url.split("/")[1]) > import.meta.env.PUBLIC_ARCHIVE_LAST_YEAR;

const sort: (a: Record<string, any>, b: Record<string, any>) => number = (
  a,
  b,
) =>
  new Date(b.frontmatter.date).valueOf() -
  new Date(a.frontmatter.date).valueOf();
---

<Main>
  <PostsList posts={posts} filter={filter} sort={sort} />
</Main>
